[Unit]
Description=Run shared agent memory synchronization

[Timer]
# Отсчёт от ЗАВЕРШЕНИЯ прошлого запуска, а не от его старта: запуск берёт
# эксклюзивную блокировку и ходит в сеть, и при отсчёте от старта долгий
# прогон наложился бы на следующий.
#
# Было раз в 2 минуты, то есть 720 запусков в сутки, каждый под блокировкой,
# тогда как хук роутера ждёт освобождения не дольше 10 секунд. Публикация и
# так идёт сразу после каждой записи в память, поэтому таймер это страховка
# на случай пропущенной публикации, а не основной путь.
OnBootSec=2min
# Календарь, а не OnUnitInactiveSec: относительный таймер не взводится
# после перезапуска таймера, пока сервис не отработает хотя бы раз
# (02.09.2026: на десктопе синхронизация молчала двое суток, публикации
# шли только руками из сессий). Persistent догоняет пропуски после сна.
OnCalendar=*:0/15
RandomizedDelaySec=90s
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target

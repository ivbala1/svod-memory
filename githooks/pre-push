#!/usr/bin/env python3
"""pre-push для любого push из репозитория памяти: сканер секретов по
диапазону удалённая..локальная покоммитно, для новой ветки по всей
истории. Сканера нет, отправки нет. Удаление ссылки не проверяется."""
from pathlib import Path
import os
import sys

ENGINE = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ENGINE / "lib"))

import svodgit  # noqa: E402

ZERO = "0" * 40


def main() -> int:
    root = Path(svodgit.out(Path.cwd(), "rev-parse", "--show-toplevel"))
    for line in sys.stdin.read().splitlines():
        parts = line.split()
        if len(parts) != 4:
            continue
        _local_ref, local_sha, _remote_ref, remote_sha = parts
        if set(local_sha) == {"0"}:
            continue
        old = None if set(remote_sha) == {"0"} else remote_sha
        if old and svodgit.git(root, "cat-file", "-e", f"{old}^{{commit}}", check=False).returncode != 0:
            old = None
        problem = svodgit.scan_range(root, old, local_sha)
        if problem:
            print(f"pre-push: {problem}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
